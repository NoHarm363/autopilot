  "/schema": {
    "status_code": 200,
    "response": {
      "$defs": {
        "Assessment": {
          "additionalProperties": false,
          "properties": {
            "summary": {
              "title": "Summary",
              "type": "string"
            },
            "sub_areas": {
              "items": {
                "enum": [
                  "sanctions_proliferation",
                  "crypto_virtual_assets",
                  "customer_due_diligence",
                  "transaction_monitoring_reporting"
                ],
                "type": "string"
              },
              "maxItems": 4,
              "minItems": 1,
              "title": "Sub Areas",
              "type": "array"
            },
            "risk_level": {
              "enum": [
                "high",
                "medium",
                "low"
              ],
              "title": "Risk Level",
              "type": "string"
            },
            "risk_rationale": {
              "title": "Risk Rationale",
              "type": "string"
            },
            "impacted_population": {
              "title": "Impacted Population",
              "type": "string"
            },
            "actual_impact": {
              "title": "Actual Impact",
              "type": "string"
            },
            "recommendations": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "title": "Recommendations",
              "type": "array"
            },
            "auditable_focus_areas": {
              "items": {
                "type": "string"
              },
              "title": "Auditable Focus Areas",
              "type": "array"
            },
            "claims": {
              "items": {
                "$ref": "#/$defs/Claim"
              },
              "minItems": 1,
              "title": "Claims",
              "type": "array"
            },
            "assessment_method": {
              "default": "unconfigured",
              "title": "Assessment Method",
              "type": "string"
            },
            "confidence": {
              "default": 0.5,
              "maximum": 1,
              "minimum": 0,
              "title": "Confidence",
              "type": "number"
            }
          },
          "required": [
            "summary",
            "sub_areas",
            "risk_level",
            "risk_rationale",
            "impacted_population",
            "actual_impact",
            "recommendations",
            "claims"
          ],
          "title": "Assessment",
          "type": "object"
        },
        "Claim": {
          "additionalProperties": false,
          "properties": {
            "statement": {
              "minLength": 1,
              "title": "Statement",
              "type": "string"
            },
            "quote": {
              "minLength": 1,
              "title": "Quote",
              "type": "string"
            },
            "locator": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Locator"
            }
          },
          "required": [
            "statement",
            "quote"
          ],
          "title": "Claim",
          "type": "object"
        },
        "SourceDocument": {
          "additionalProperties": false,
          "properties": {
            "url": {
              "title": "Url",
              "type": "string"
            },
            "title": {
              "minLength": 1,
              "title": "Title",
              "type": "string"
            },
            "text": {
              "minLength": 20,
              "title": "Text",
              "type": "string"
            },
            "retrieved_at": {
              "format": "date-time",
              "title": "Retrieved At",
              "type": "string"
            },
            "published_date": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Published Date"
            },
            "revised_date": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Revised Date"
            },
            "effective_date": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Effective Date"
            },
            "date_evidence": {
              "additionalProperties": {
                "type": "string"
              },
              "title": "Date Evidence",
              "type": "object"
            },
            "document_type": {
              "default": "other",
              "enum": [
                "notice",
                "guideline",
                "consultation",
                "enforcement",
                "statement",
                "other"
              ],
              "title": "Document Type",
              "type": "string"
            },
            "content_hash": {
              "default": "",
              "title": "Content Hash",
              "type": "string"
            },
            "retrieval_method": {
              "default": "direct_http",
              "title": "Retrieval Method",
              "type": "string"
            },
            "provenance": {
              "default": "live",
              "enum": [
                "live",
                "manual_public_snapshot",
                "test_fixture"
              ],
              "title": "Provenance",
              "type": "string"
            },
            "links": {
              "items": {
                "type": "string"
              },
              "title": "Links",
              "type": "array"
            }
          },
          "required": [
            "url",
            "title",
            "text"
          ],
          "title": "SourceDocument",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SourceDocument"
        },
        "assessment": {
          "$ref": "#/$defs/Assessment"
        },
        "verification_status": {
          "enum": [
            "verified",
            "needs_review"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "verification_notes": {
          "items": {
            "type": "string"
          },
          "title": "Verification Notes",
          "type": "array"
        },
        "change_type": {
          "enum": [
            "baseline",
            "updated"
          ],
          "title": "Change Type",
          "type": "string"
        },
        "previous_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Hash"
        },
        "diff": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diff"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "human_review_required": {
          "const": true,
          "default": true,
          "title": "Human Review Required",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source",
        "assessment",
        "verification_status",
        "change_type"
      ],
      "title": "PolicyEvent",
      "type": "object"
    }
  }
}